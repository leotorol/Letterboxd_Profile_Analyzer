# Local development only. Never commit real keys.
# Direct browser key used by npm run dev.
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Server side key used by the Vercel functions in production.
# Set this in Vercel, not in the repository.
TMDB_API_KEY=

# Optional. Provision Upstash Redis from the Vercel Marketplace to enable the
# shared enrichment queue. Without it the app still works, just without a queue.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Overrides the canonical URL and sitemap origin.
# Vercel already injects its own domain during the build.
VITE_SITE_URL=

# Optional queue tuning.
TMDB_QUEUE_MAX_ACTIVE=2
TMDB_QUEUE_LEASE_SECONDS=120
